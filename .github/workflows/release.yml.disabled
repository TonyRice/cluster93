# Builds the native `c93` CLI for every platform and leaves it as a draft GitHub release (D-049, D-069).
# The maintainer then signs SHA256SUMS on their own machine and publishes it: scripts/sign-release.sh TAG. The signing
# key never comes near GitHub, so this workflow can't publish anything the installers will accept.
#
# Runs ONLY when a version tag is pushed (git tag v2.1.0 && git push origin v2.1.0); it is not CI, so D-017
# stands. native-image can't cross-compile, which is why each platform builds on its own runner.
name: release

on:
  push:
    tags: ['v*']

permissions:
  contents: write

jobs:
  # A tag must match the project version, so the CLI never reports the wrong one.
  guard:
    name: tag matches the version
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: The tag must match the project version
        run: |
          tag="${GITHUB_REF_NAME#v}"
          pom="$(./mvnw -q -B -ntp -N help:evaluate -Dexpression=project.version -DforceStdout | tail -1)"
          echo "tag=${tag}  pom=${pom}"
          if [ "$tag" != "$pom" ]; then
            echo "::error::tag ${GITHUB_REF_NAME} does not match the project version ${pom}; run scripts/version.sh set ${tag}"
            exit 1
          fi

  native:
    needs: guard
    name: ${{ matrix.asset }}
    strategy:
      fail-fast: false
      matrix:
        include:
          # Static against musl: runs on any Linux distro, Alpine included.
          - { os: ubuntu-latest, asset: cluster93-linux-x64, musl: 'true', extra: '--static --libc=musl' }
          # GraalVM's musl support is x64 only; arm64 links glibc, built for broad CPU compatibility.
          - { os: ubuntu-24.04-arm, asset: cluster93-linux-arm64, musl: 'false', extra: '-march=compatibility' }
          - { os: macos-14, asset: cluster93-macos-arm64, musl: 'false', extra: '-march=compatibility' }
          - { os: macos-15-intel, asset: cluster93-macos-x64, musl: 'false', extra: '-march=compatibility' }
          - { os: windows-latest, asset: cluster93-windows-x64.exe, musl: 'false', extra: '-march=compatibility' }
    runs-on: ${{ matrix.os }}
    defaults:
      run:
        shell: bash
    steps:
      - uses: actions/checkout@v4
      - uses: graalvm/setup-graalvm@v1
        with:
          java-version: '21'
          distribution: graalvm-community
          native-image-musl: ${{ matrix.musl }}
          github-token: ${{ secrets.GITHUB_TOKEN }}
      - name: Build the native binary
        run: ./mvnw -B -ntp -Pnative -pl cli -am package -DskipTests "-Dnative.extra.args=${{ matrix.extra }}"
      - name: Name it for the release
        run: |
          if [ -f cli/target/c93.exe ]; then src=cli/target/c93.exe; else src=cli/target/c93; fi
          mkdir -p dist && cp "$src" "dist/${{ matrix.asset }}"
      - name: Smoke test
        run: ./dist/${{ matrix.asset }} --version
      - name: Smoke test against a real node (Linux x64)
        if: matrix.asset == 'cluster93-linux-x64'
        run: |
          ./mvnw -B -ntp -pl server -am package -DskipTests -DskipITs
          export C93_ADMIN_TOKEN=release-smoke-admin-token-0123456789abcdef
          java $(./mvnw -q help:evaluate -Dexpression=ignite.jvm.args -DforceStdout) -jar server/target/c93.jar &
          for i in $(seq 60); do curl -sf localhost:9393/health && break; sleep 1; done
          cli=./dist/cluster93-linux-x64
          $cli --url http://localhost:9393 --token "$C93_ADMIN_TOKEN" tenants create smoke
          token=$($cli --url http://localhost:9393 --token "$C93_ADMIN_TOKEN" tenants token smoke ci --scope '*')
          echo "export default (input) => ({ hello: input.name })" > hello.js
          C93_URL=http://localhost:9393 C93_TOKEN="$token" $cli run hello.js --input '{"name":"release"}' | grep release
      - uses: actions/upload-artifact@v4
        with:
          name: ${{ matrix.asset }}
          path: dist/${{ matrix.asset }}
          if-no-files-found: error

  publish:
    needs: native
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/download-artifact@v4
        with:
          path: dist
          merge-multiple: true
      - name: Checksums and installers
        run: |
          cp install/install.sh install/install.ps1 dist/
          cd dist && sha256sum cluster93-* install.sh install.ps1 > SHA256SUMS && cat SHA256SUMS
      - name: Draft the release, for scripts/sign-release.sh to sign and publish
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          tag="$GITHUB_REF_NAME"
          # A pre-release (tag contains a hyphen, e.g. v2.0.0-alpha.1) is marked as
          # such, so releases/latest never serves it.
          flags="--draft --title $tag --generate-notes"
          case "$tag" in *-*) flags="$flags --prerelease" ;; esac
          gh release create "$tag" dist/* $flags
