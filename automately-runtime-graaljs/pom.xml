<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>automately</groupId>
        <artifactId>automately-parent</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>automately-runtime-graaljs</artifactId>
    <name>Automately Runtime (GraalJS)</name>
    <description>
        Runs jobs on embedded GraalJS (D-126): the engine-neutral runtime's GraalJS adapter, for comparison with V8. By
        default each engine runs its guests in their own polyglot isolate, with a heap limit per run.
    </description>

    <dependencies>
        <dependency>
            <groupId>automately</groupId>
            <artifactId>automately-runtime-js</artifactId>
        </dependency>
        <dependency>
            <groupId>org.graalvm.polyglot</groupId>
            <artifactId>polyglot</artifactId>
        </dependency>
        <!-- GraalJS in the host's own heap (in-process mode). -->
        <dependency>
            <groupId>org.graalvm.polyglot</groupId>
            <artifactId>js-community</artifactId>
            <type>pom</type>
        </dependency>
        <!-- GraalJS in a polyglot isolate with its own heap (the default mode), for linux-x86_64. -->
        <dependency>
            <groupId>org.graalvm.polyglot</groupId>
            <artifactId>js-isolate-linux-amd64-community</artifactId>
            <type>pom</type>
        </dependency>
        <!-- The conformance suite (D-126), run here against GraalJS. -->
        <dependency>
            <groupId>automately</groupId>
            <artifactId>automately-runtime-js</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>automately</groupId>
            <artifactId>automately-core</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Runs the engine-neutral conformance suite (automately-runtime-js's tests) on this engine. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <dependenciesToScan>
                        <dependency>automately:automately-runtime-js</dependency>
                    </dependenciesToScan>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
