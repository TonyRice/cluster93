{
  "name": "console",
  "version": "2.0.0",
  "distDir": "out",
  "routes": [
    { "src": "/v1/(.*)", "dest": "api:/v1/$1" },
    { "src": ".*", "dest": "/index.html", "status": 200 }
  ],
  "headers": [
    { "source": "/_next/static/(.*)", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } }
  ]
}
