<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cluster93</groupId>
        <artifactId>cluster93-parent</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>cluster93-cluster-ignite</artifactId>
    <name>Cluster93 Cluster (Apache Ignite)</name>
    <description>The cluster is the database: Ignite as Vert.x cluster manager and as durable, replicated storage. The only module that knows about Ignite.</description>

    <dependencies>
        <dependency>
            <groupId>cluster93</groupId>
            <artifactId>cluster93-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-ignite</artifactId>
        </dependency>
        <dependency>
            <!-- Ignite's current SQL engine; indexes make tenant listings and kv.list efficient. -->
            <groupId>org.apache.ignite</groupId>
            <artifactId>ignite-calcite</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.ignite</groupId>
            <artifactId>ignite-slf4j</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cluster93</groupId>
            <artifactId>cluster93-core</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{ignite.jvm.args}</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
